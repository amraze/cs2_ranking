# Dev environment - no production build
FROM node:22.18

WORKDIR /app

RUN npm install -g @angular/cli

COPY package*.json ./
RUN npm install

# Expose Angular dev server port
EXPOSE 4200

# Enable polling for file change detection (needed on Docker/WSL)
ENV CHOKIDAR_USEPOLLING=true

# Run Angular dev server
CMD ["ng", "serve", "--host", "0.0.0.0", "--poll=200"]
